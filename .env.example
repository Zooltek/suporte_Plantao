# 1. Configurações Globais (Docker e Vite)
APP_NAME=Suporte
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

# Override opcional para o modo compartilhado via LAN (`make lan`).
# Deixe vazio para o app responder no IP/hostname atual da máquina via request.
# Preencha apenas se algum fluxo precisar gerar URL absoluta pública.
# Exemplo: http://IP-OU-HOST:8090 ou http://nome-da-maquina.local:8090
APP_PUBLIC_URL=

# URL do sistema de tarefas usado por `popupTarefa()`
TASK_APP_URL=http://dev004

# URL da API de notificações externa
NOTIFICATION_API_URL=http://localhost/consuldata-panel/public/api/tasks/notifications

# URL base do Sistema Plenus para sincronização
PLENUS_API_URL=https://sistemaplenus.com.br

# 2. Configurações de Broadcast (Pusher)
PUSHER_APP_ID=local
PUSHER_APP_KEY=local
PUSHER_APP_SECRET=local
PUSHER_APP_CLUSTER=mt1
PUSHER_PORT=443
PUSHER_SCHEME=https
BROADCAST_CONNECTION=pusher

# 3. Configurações para o Vite (Frontend)
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Host usado somente pelo Vite HMR em `make dev`.
# Deixe vazio (ou não defina) para usar 'localhost' — padrão de desenvolvimento.
# Preencha apenas se você realmente precisar compartilhar o HMR na rede local.
# Para homologação compartilhada via navegador em outra máquina, prefira
# `APP_PUBLIC_URL=... make lan`, que usa assets compilados sem depender do Vite.
VITE_HMR_HOST=

# 4. Localização e Logs
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 5. Banco de Dados (único)
DB_CONNECTION=mysql
DB_HOST=suporte12_mysql
DB_PORT=3306
DB_DATABASE=suporte12_db
DB_USERNAME=suporte12_user
DB_PASSWORD=suporte12_password
DB_ROOT_PASSWORD=suporte12_root_password
# Porta/endereço de publicação do MySQL no host — usados SOMENTE com o overlay
# opt-in `docker-compose.dbport.yml` (via `make dev DB_EXPOSE=1`). Por padrão o
# MySQL não é publicado no host. Ajuste DB_HOST_PORT se a 3306 estiver ocupada.
DB_HOST_PORT=3306
DB_BIND_ADDRESS=127.0.0.1

# 6. Sessão, Cache e Fila
SESSION_DRIVER=redis
SESSION_LIFETIME=600
SESSION_COOKIE=laravel_session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# 7. Redis
REDIS_CLIENT=phpredis
REDIS_HOST=suporte12_redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Redis — databases por finalidade (ver config/redis.php e config/database.php)
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_RATE_LIMITER_DB=4
REDIS_RATE_LIMITER_CONNECTION=rate_limiter

# TTLs do cache Redis (segundos)
REDIS_TTL_SHORT=300
REDIS_TTL_DEFAULT=3600
REDIS_TTL_LONG=86400
REDIS_TTL_SESSION=36000

# Rate Limiting — requisições por minuto (ver config/redis.php rate_limits)
RATE_LIMIT_API=60
RATE_LIMIT_API_STRICT=30
RATE_LIMIT_REPORTS=10
RATE_LIMIT_TASKS_API=120
RATE_LIMIT_ADMIN_API=60
RATE_LIMIT_WHATSAPP_WEBHOOK=300
RATE_LIMIT_INTEGRATION=60
RATE_LIMIT_PASSWORD_RESET=3
RATE_LIMIT_AUTH=5

# Integração com o sistema financeiro (inbound via API key no header X-API-Key)
# Fail-closed: se vazio, os endpoints /api/v1/integration/* respondem 401.
FINANCEIRO_API_KEY=

# 8. Mail
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.kinghost.net
MAIL_PORT=465
MAIL_USERNAME=noreply@amura.com.br
MAIL_PASSWORD=defina_sua_senha_smtp_aqui
MAIL_FROM_ADDRESS="noreply@amura.com.br"
MAIL_FROM_NAME="Amura"
MAIL_EHLO_DOMAIN=amura.com.br

SCOUT_DRIVER=database

# Configuração Telescope
TELESCOPE_ENABLED=true

# Swagger
L5_SWAGGER_CONST_HOST=http://localhost:8090
L5_SWAGGER_GENERATE_ALWAYS=true

# 8. Docker User/Group ID
APP_UID=1000
APP_GID=1000

# ─────────────────────────────────────────────────────────────────────────────
# 9. WhatsApp Business API
# ─────────────────────────────────────────────────────────────────────────────

WHATSAPP_ENABLED=true

# Provedor ativo: generic | evolution
# generic  → Meta Cloud API (API Oficial)
# evolution → Evolution-API v2 (self-hosted)
WHATSAPP_PROVIDER=evolution

WHATSAPP_FROM_NUMBER=27981180125

# URL base do servidor do provedor ativo.
# Evolution-API: URL do seu servidor (ex: https://evolution.amura.app)
# Meta Cloud:    https://graph.facebook.com/v18.0/{PHONE_NUMBER_ID}
WHATSAPP_API_URL=http://suporte12_evolution:8080

# URL pública do webhook recebido pela Evolution.
# Em produção, deve ser acessível externamente pela instância da Evolution.
WHATSAPP_WEBHOOK_URL="${APP_URL}/api/webhook/whatsapp"

# ── Evolution-API v2 ──────────────────────────────────────────────────────────
# Nome da instância criada no painel Evolution (WHATSAPP_PROVIDER=evolution)
WHATSAPP_EVOLUTION_INSTANCE=amura-local

# Chave de autenticação enviada no header `apikey` de todas as requisições.
WHATSAPP_EVOLUTION_API_KEY=amura-local-evo-key-2024

# ── Meta Cloud API (API Oficial) ──────────────────────────────────────────────
# Usado apenas quando WHATSAPP_PROVIDER=generic
WHATSAPP_API_TOKEN=

# Segredo HMAC (X-Hub-Signature-256). Em branco = sem validação (somente dev).
WHATSAPP_WEBHOOK_SECRET=

# ── Chatbot ───────────────────────────────────────────────────────────────────
# Tempo em minutos antes de uma conversa inativa ser expirada
WHATSAPP_SESSION_TTL=60

# Tenta identificar automaticamente o cliente pelo telefone recebido
WHATSAPP_AUTO_IDENTIFY_COMPANY_BY_PHONE=true

# Origin ID para tickets abertos via WhatsApp (ticketit_origin)
WHATSAPP_ORIGIN_ID=5

# Agent padrão legado (tickets do bot entram na fila do setor, sem agente)
WHATSAPP_DEFAULT_AGENT_ID=

# Status inicial dos tickets criados via WhatsApp (4 = Pendente)
WHATSAPP_DEFAULT_STATUS_ID=4

# Prioridade padrão
WHATSAPP_DEFAULT_PRIORITY_ID=1

# ── Mapeamento área → category_id do ticketit ────────────────────────────────
# IDs das categorias no banco. Ex: 1 = Suporte, 2 = Financeiro, 3 = Comercial
WHATSAPP_CATEGORY_SUPORTE=1
WHATSAPP_CATEGORY_FINANCEIRO=1
WHATSAPP_CATEGORY_COMERCIAL=1

# ── Mapeamento área → department_id do ticketit ────────────────────────────────
WHATSAPP_DEPARTMENT_SUPORTE_ID=1
WHATSAPP_DEPARTMENT_FINANCEIRO_ID=2
WHATSAPP_DEPARTMENT_COMERCIAL_ID=3

# ── Mensagens do Chatbot ─────────────────────────────────────────────────────
# Personalize as mensagens enviadas pelo bot. Deixe vazio para usar o padrão.
# Variáveis disponíveis: {name}, {company}, {area}, {problem}, {attachments},
#                        {ticket_id}, {subject}, {status}, {date}

WHATSAPP_MSG_MENU="Olá! 👋 Bem-vindo ao suporte *Amura*.\n\nComo posso te ajudar?\n\n1️⃣ Abrir um chamado\n2️⃣ Consultar status do meu chamado\n3️⃣ Falar com um atendente\n\nResponda com o número da opção."
WHATSAPP_MSG_HUMAN_PENDING="✋ Certo! Estou te conectando com um de nossos atendentes.\n\nAguarde, em breve você será atendido. Nosso horário de atendimento é de segunda a sexta, das 8h às 18h."
WHATSAPP_MSG_STATUS_FOUND="📋 *Seu chamado mais recente:*\n\n🔢 Número: #{ticket_id}\n📝 Assunto: {subject}\n🔄 Status: *{status}*\n📅 Aberto em: {date}\n\nSe precisar de mais informações, fale com um atendente (opção 3)."
WHATSAPP_MSG_STATUS_NOT_FOUND="ℹ️ Não encontramos chamados em seu nome.\n\nSe quiser abrir um chamado ou falar com um atendente, volte ao menu principal."
WHATSAPP_MSG_GREETING="Ótimo! Vamos abrir seu chamado.\n\n*Qual o seu nome?*"
WHATSAPP_MSG_ASK_COMPANY="Obrigado, *{name}*! 😊\n\n*Qual o nome da empresa?*"
WHATSAPP_MSG_ASK_COMPANY_CNPJ="*Informe o CNPJ da empresa* para abrirmos um cadastro mínimo do chamado.\n_Pode digitar somente os números ou com pontuação (ex.: 12.345.678/0001-90)._"
WHATSAPP_MSG_ASK_COMPANY_PHONE='*Informe o telefone com DDD* para contato.'
WHATSAPP_MSG_COMPANY_IDENTIFIED="Perfeito, *{name}*! 😊\n\nIdentifiquei sua empresa como *{company}* pelo número informado."
WHATSAPP_MSG_ASK_AREA="Entendido! Em qual área você precisa de atendimento?\n\n1️⃣ Suporte Técnico\n2️⃣ Financeiro\n3️⃣ Comercial\n\nResponda com o número da opção."
WHATSAPP_MSG_ASK_PROBLEM="Área: *{area}* ✅\n\nDescreva o problema ou solicitação com o máximo de detalhes possível:"
WHATSAPP_MSG_ASK_ATTACHMENT="Você pode enviar anexos agora (imagens, documentos, áudios ou vídeos).\n\nQuando terminar, digite *confirmar* para abrir o chamado ou *cancelar* para recomeçar."
WHATSAPP_MSG_CONFIRM="📋 *Resumo do chamado:*\n\n👤 Solicitante: {name}\n🏢 Empresa: {company}\n🧾 CNPJ: {cnpj}\n☎️ Telefone: {phone}\n📂 Área: {area}\n📝 Problema: {problem}\n📎 Anexos: {attachments}\n\n*1 - Confirmar* e abrir o chamado\n*2 - Cancelar* e recomeçar"
WHATSAPP_MSG_CREATED="✅ *Chamado #{ticket_id} aberto com sucesso!*\n\nAssim que um agente for designado, você será notificado.\n\nObrigado por entrar em contato!"
WHATSAPP_MSG_COMPANY_NOT_FOUND="⚠️ Não encontramos a empresa *{company}* em nossa base de clientes.\n\nVou coletar dados básicos para abrir o chamado via WhatsApp."
WHATSAPP_MSG_OUT_OF_HOURS='Estamos fora do horário de expediente. Nosso atendimento é de segunda a sexta, das 08:30 às 18:00. Sua mensagem ficará registrada.'
WHATSAPP_MSG_INVALID='Opção inválida. Por favor, responda com 1, 2 ou 3.'
WHATSAPP_MSG_CANCELLED='Atendimento cancelado. Digite qualquer mensagem para iniciar novamente.'
WHATSAPP_MSG_CONVERSATION_FINISHED="Seu atendimento foi finalizado com sucesso.\nConte conosco sempre que precisar novamente."
WHATSAPP_MSG_ERROR='Ocorreu um erro ao processar sua solicitação. Por favor, tente novamente em instantes.'
WHATSAPP_MSG_GREETING_IDENTIFIED="Oi 👋 Seja bem-vindo ao suporte da *Amura*!\nPara começar, pode me passar o *CNPJ* da sua empresa?\n_Pode digitar somente os números ou com pontuação (ex.: 12.345.678/0001-90)._"
WHATSAPP_MSG_GREETING_BY_PHONE="Oi 👋 Seja bem-vindo ao suporte da *Amura*!\n\nLocalizei seu cadastro vinculado a *{company}*. ✅\n\nPara registrar o atendimento, me informe seu *nome*."
WHATSAPP_MSG_CNPJ_LOCATED="Perfeito! ✅ Localizei seu cadastro.\n\nAgora me informe seu *nome* para eu registrar o atendimento."
WHATSAPP_MSG_SECTOR_CHOICE="Obrigado, *{name}*! 😄\n\nCom qual setor você gostaria de falar hoje?\n\n1️⃣ Suporte técnico\n2️⃣ Financeiro\n3️⃣ Comercial\n\nDigite o número ou o nome da opção."
WHATSAPP_MSG_PROBLEM_SUPPORT="Para {sector} ✅\n\nPara agilizar o atendimento, me conta o que você precisa — se quiser, pode enviar imagens 📸 ou documentos 📎"
WHATSAPP_MSG_PROBLEM_FINANCEIRO="Perfeito! 💰\n\nVocê pode mandar uma mensagem direto para o nosso número do setor financeiro 📞 27 98132-4555,\nou, se preferir, posso abrir um chamado para que nossa equipe entre em contato com você.\n\nO que você prefere fazer?\n1️⃣ Abrir chamado para retorno\n2️⃣ Encerrar"
WHATSAPP_MSG_PROBLEM_COMERCIAL="Beleza! Nosso time Comercial pode te ajudar.\nVocê também pode ligar direto para 📞 27 98810-8533.\n\nO que você prefere fazer?\n1️⃣ Abrir chamado para retorno\n2️⃣ Encerrar"
WHATSAPP_MSG_GOODBYE='Tudo bem! Se precisar, é só voltar aqui.\nAté mais 👋'
WHATSAPP_MSG_SESSION_EXPIRED='Sua sessão foi encerrada por inatividade. Para continuar, é só mandar uma mensagem que começamos novamente! 👋'
WHATSAPP_MSG_CNPJ_NOT_FOUND="Hmm... não encontrei esse CNPJ no nosso sistema 🤔\nMas sem problema, veja as opções:\n\n1️⃣ Falar com nosso time Comercial\n2️⃣ Digitar o CNPJ novamente\n3️⃣ Encerrar atendimento\n\nDigite o número ou o nome da opção."
WHATSAPP_MSG_NOT_FOUND_COMERCIAL="Beleza! Nosso time Comercial pode te ajudar.\nVocê também pode ligar direto para 📞 27 98810-8533.\n\nPara adiantar o processo, preciso de alguns dados rápidos:\nQual o seu *nome*?"
WHATSAPP_MSG_ASK_COMPANY_NOT_FOUND="Obrigado, *{name}*! 👍\n\nQual o nome da *empresa*?"
WHATSAPP_MSG_PHONE_CHOICE="Perfeito! Agora sobre o telefone:\nQuer usar o número que você está falando comigo agora para contato,\nou prefere informar outro?\n\n1️⃣ Usar número atual\n2️⃣ Informar outro"
WHATSAPP_MSG_PHONE_REGISTERED='Vou registrar esse número para retorno. 👍'
WHATSAPP_MSG_ASK_PHONE_OTHER='Sem problema! Me passa o *telefone com DDD* que você quer usar para contato.'
WHATSAPP_MSG_NOT_FOUND_ACK='Show! Já anotei tudo.'
WHATSAPP_MSG_NOT_FOUND_DEFAULT_PROBLEM='Cliente não cadastrado — solicita retorno do time Comercial.'
WHATSAPP_MSG_SUMMARY_NOT_FOUND="📋 Aqui está o resumo do seu chamado:\n\n👤 Nome: {name}\n🏢 Empresa: {company}\n🧾 CNPJ: {cnpj}\n☎️ Telefone: {phone}\n📂 Área: Comercial\n\n*1 - Confirmar* o atendimento\n*2 - Cancelar* e recomeçar"
