# ──────────────────────────────────────────────────────────────────────────────
# .env.production.example
#
# Template para o .env de produção. Copie para .env no servidor e preencha TODAS
# as senhas/chaves com valores fortes e únicos (NUNCA use os defaults).
#
#   cp .env.production.example .env
#   nano .env                        # preencher senhas fortes
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# ⚠️  NUNCA commite o .env preenchido.
# ──────────────────────────────────────────────────────────────────────────────

# 1. Configurações Globais
APP_NAME=Suporte
APP_ENV=production
APP_KEY=                                  # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://suporte.seu-dominio.com.br

# URLs externas — ajustar para o host correto de produção
TASK_APP_URL=
NOTIFICATION_API_URL=
PLENUS_API_URL=https://sistemaplenus.com.br

# 2. Broadcast (Pusher — valores reais, não "local")
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_PORT=443
PUSHER_SCHEME=https
BROADCAST_CONNECTION=pusher

# 3. Vite (lido no build de assets)
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# 4. Localização e Logs
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# 5. Banco de Dados — SENHAS FORTES OBRIGATÓRIAS
DB_CONNECTION=mysql
DB_HOST=suporte12_mysql
DB_PORT=3306
DB_DATABASE=suporte12_db
DB_USERNAME=suporte12_user
DB_PASSWORD=                              # gere senha forte (ex: openssl rand -base64 32)
DB_ROOT_PASSWORD=                         # gere senha forte (ex: openssl rand -base64 32)

# 6. Sessão, Cache e Fila
SESSION_DRIVER=redis
SESSION_LIFETIME=600
SESSION_COOKIE=laravel_session
SESSION_SECURE_COOKIE=true                # só via HTTPS em produção
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis

# 7. Redis
REDIS_CLIENT=phpredis
REDIS_HOST=suporte12_redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_RATE_LIMITER_DB=4
REDIS_RATE_LIMITER_CONNECTION=rate_limiter

REDIS_TTL_SHORT=300
REDIS_TTL_DEFAULT=3600
REDIS_TTL_LONG=86400
REDIS_TTL_SESSION=36000

RATE_LIMIT_API=60
RATE_LIMIT_API_STRICT=30
RATE_LIMIT_REPORTS=10
RATE_LIMIT_TASKS_API=120
RATE_LIMIT_ADMIN_API=60
RATE_LIMIT_INTEGRATION=60
RATE_LIMIT_PASSWORD_RESET=3
RATE_LIMIT_AUTH=5

# Integração com o sistema financeiro (inbound via API key no header X-API-Key)
# Gere uma chave forte (ex: openssl rand -hex 32). Fail-closed: se vazio, os
# endpoints /api/v1/integration/* respondem 401.
FINANCEIRO_API_KEY=

# 8. Mail — credenciais SMTP reais
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.kinghost.net
MAIL_PORT=465
MAIL_USERNAME=noreply@amura.com.br
MAIL_PASSWORD=                            # preencher
MAIL_FROM_ADDRESS="noreply@amura.com.br"
MAIL_FROM_NAME="Amura"
MAIL_EHLO_DOMAIN=amura.com.br

SCOUT_DRIVER=database

# Telescope — DESLIGADO em produção
TELESCOPE_ENABLED=false

# Swagger — não regerar a cada request em produção
L5_SWAGGER_CONST_HOST=https://suporte.seu-dominio.com.br
L5_SWAGGER_GENERATE_ALWAYS=false

# Docker User/Group ID (ajuste para o usuário que roda docker no servidor)
APP_UID=1000
APP_GID=1000

# ─────────────────────────────────────────────────────────────────────────────
# 9. WhatsApp Business API
# ─────────────────────────────────────────────────────────────────────────────
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=evolution
WHATSAPP_FROM_NUMBER=
WHATSAPP_API_URL=                         # URL da Evolution-API de produção
WHATSAPP_WEBHOOK_URL="${APP_URL}/api/webhook/whatsapp"
WHATSAPP_EVOLUTION_INSTANCE=
WHATSAPP_EVOLUTION_API_KEY=               # chave real, não "amura-local-evo-key-2024"
WHATSAPP_API_TOKEN=
WHATSAPP_WEBHOOK_SECRET=                  # HMAC forte para X-Hub-Signature-256
WHATSAPP_SESSION_TTL=60
WHATSAPP_AUTO_IDENTIFY_COMPANY_BY_PHONE=true
WHATSAPP_ORIGIN_ID=5
WHATSAPP_DEFAULT_AGENT_ID=
WHATSAPP_DEFAULT_STATUS_ID=4
WHATSAPP_DEPARTMENT_SUPORTE_ID=1
WHATSAPP_DEPARTMENT_FINANCEIRO_ID=2
WHATSAPP_DEPARTMENT_COMERCIAL_ID=3
WHATSAPP_DEFAULT_PRIORITY_ID=1

WHATSAPP_CATEGORY_SUPORTE=1
WHATSAPP_CATEGORY_FINANCEIRO=1
WHATSAPP_CATEGORY_COMERCIAL=1

WHATSAPP_MSG_MENU=
WHATSAPP_MSG_HUMAN_PENDING=
WHATSAPP_MSG_STATUS_FOUND=
WHATSAPP_MSG_STATUS_NOT_FOUND=
WHATSAPP_MSG_GREETING=
WHATSAPP_MSG_ASK_COMPANY=
WHATSAPP_MSG_COMPANY_IDENTIFIED=
WHATSAPP_MSG_ASK_AREA=
WHATSAPP_MSG_ASK_PROBLEM=
WHATSAPP_MSG_ASK_ATTACHMENT=
WHATSAPP_MSG_CONFIRM=
WHATSAPP_MSG_CREATED=
WHATSAPP_MSG_COMPANY_NOT_FOUND=
WHATSAPP_MSG_INVALID=
WHATSAPP_MSG_CANCELLED=
WHATSAPP_MSG_ERROR=
