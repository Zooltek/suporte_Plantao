# Ambiente de Testes
APP_NAME=Suporte
APP_ENV=testing
APP_KEY=base64:4Ett5vcS89qKyW9ZfUOqpJPkCI7mA+nBGbWazjzVjIo=
APP_DEBUG=true
APP_URL=http://localhost:8090

# URLs externas
TASK_APP_URL=http://dev004
NOTIFICATION_API_URL=http://localhost/consuldata-panel/public/api/tasks/notifications
PLENUS_API_URL=https://sistemaplenus.com.br

# Broadcast
PUSHER_APP_ID=local
PUSHER_APP_KEY=local
PUSHER_APP_SECRET=local
PUSHER_APP_CLUSTER=mt1
PUSHER_PORT=443
PUSHER_SCHEME=https
BROADCAST_CONNECTION=pusher

# Vite
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Localização e Logs
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de Dados (SQLite em memória para testes)
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Sessão, Cache e Fila
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_COOKIE=laravel_session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_DRIVER=array

# Redis e Mail
REDIS_CLIENT=phpredis
REDIS_HOST=suporte12_redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SCOUT_DRIVER=database

# Telescope
TELESCOPE_ENABLED=false

# Swagger
L5_SWAGGER_CONST_HOST=http://localhost:8090
L5_SWAGGER_GENERATE_ALWAYS=false

# Docker User/Group ID
UID=1000
GID=1000
